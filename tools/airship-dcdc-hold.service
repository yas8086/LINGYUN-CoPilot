# 灵云01号伴飞电脑 — DCDC 硬件保活服务
#
# 目的: 独立于 ROS2 系统, 保证 DCDC 控制帧始终以 200ms 周期下发。
#       即使 ROS2/launch/DDS 崩溃, DCDC 仍保持输出(不因控制帧中断而断电)。
#
# 与 airship_params.yaml 的 dcdc_node 参数保持一致:
#   DCDC_ENABLED=1 / DCDC_SET_VOLTAGE=49.0 / DCDC_SET_CURRENT=5.0 / can0
#
# 安装:
#   sudo cp tools/airship-dcdc-hold.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable airship-dcdc-hold
#   sudo systemctl start  airship-dcdc-hold

[Unit]
Description=Lingyun DCDC Hardware Keepalive (CAN control frame)
# 显式依赖 CAN 接口配置完成(airship-can.service 配置 can0@250k)后再生效,
# 避免开机时 can0 未配置导致保活帧发送失败(靠 Restart 兜底, 但顺序应明确)
After=network-online.target airship-can.service
Wants=network-online.target

[Service]
Type=simple
# 无需 ROS2, 直接运行保活二进制 (无 ROS 依赖, 更可靠)
ExecStart=/home/lingyun01/LINGYUN-CoPilot/install/airship_dcdc/lib/airship_dcdc/dcdc_hold
Environment=DCDC_CAN_IF=can0
Environment=DCDC_ENABLED=1
Environment=DCDC_SET_VOLTAGE=49.0
Environment=DCDC_SET_CURRENT=5.0
Environment=DCDC_PERIOD_MS=200

# 崩溃自愈: 保活进程绝不能长时间停止
Restart=always
RestartSec=1
TimeoutStartSec=10

# 日志交给 journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
