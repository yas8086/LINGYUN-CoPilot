# 灵云01号伴飞电脑 — rosbag 每日清理定时器
# 每日一次触发 airship-bag-clean.service 删除过期记录。
#
# ===== DEPRECATED (2026-08-27) =====
# 已由 airship-disk-guard.timer(每 10 分钟, 含水位删除+红线停录)取代。
# 保留文件仅作历史参考/回退用, install_production.sh 不再 enable。
[Unit]
Description=Daily airship rosbag cleanup (DEPRECATED, replaced by airship-disk-guard)

[Timer]
OnCalendar=daily
Persistent=true

[Install]
WantedBy=timers.target