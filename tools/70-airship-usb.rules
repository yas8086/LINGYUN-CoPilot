# 灵云01号伴飞电脑 — USB 串口设备固定命名 udev 规则
#
# 问题: /dev/ttyUSB* 由 USB 枚举顺序分配, 插拔/重启顺序变化会串号。
# 	 例如 FTDI 485 当前是 ttyUSB5, 若 4G 模块先枚举可能变成 ttyUSB6。
# 解决: 按 VID/PID + 接口号绑定稳定的符号链接, 节点只依赖符号链接。
#
# 安装: sudo cp 70-airship-usb.rules /etc/udev/rules.d/
#       sudo udevadm control --reload-rules && sudo udevadm trigger --action=add --subsystem-match=tty
#
# 设备对照(在本机采集):
#   /dev/airship_485       <- FT232R USB-RS485 (0403:6001), LoRa 集中器
#   /dev/airship_4g_at0..4 <- SimTech SIM7600 4G (1e0e:9001), 5 个端口
#   /dev/airship_link      <- 数传电台 (VID/PID 待确认, 见下方占位规则)
#
# 注意: SimTech 4G 的 5 个端口 VID/PID 相同, 用 ID_USB_INTERFACE_NUM(接口号) 区分。
#       ID_USB_INTERFACE_NUM 是 tty 设备自身的 udev 属性, 稳定标识接口号。

# ---- LoRa 485 集中器 (FTDI FT232R) ----
# 注: 集中器已改接微雪 RS232-RS485-CAN-Board 的 RS485_1 (/dev/ttySC0),
#     /dev/airship_485 现由 71-airship-extboards.rules 绑定到 ttySC0。
#     此旧 FTDI 规则注释掉, 避免与 ttySC0 的 airship_485 符号链接冲突。
# SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", \
#   SYMLINK+="airship_485", GROUP="dialout", MODE="0660"

# ---- 12S 备用电源 BMS (北辰协议 串口) ----
# 已改接微雪 RS232-RS485-CAN-Board 的 RS485_2 (/dev/ttySC1),
# /dev/airship_backup_bms 由 71-airship-extboards.rules 绑定到 ttySC1。
# 下方 USB 占位规则不再需要(保留历史说明, 勿再启用以免符号链接冲突):
# SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="XXXX", \
#   SYMLINK+="airship_backup_bms", GROUP="dialout", MODE="0660"

# ---- 数传电台 ----
# 数传 L33 经网口接入交换机(UART1 TTL 接飞控 Telem1, 不接树莓派串口),
# 业务数据走 UDP(高位端口 20000) 经数传 MAC 层透传, 不占用树莓派串口,
# /dev/airship_link 串口符号链接规则预留(若未来接串口数传再启用):
# SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="XXXX", \
#   SYMLINK+="airship_link", GROUP="dialout", MODE="0660"

# ---- SimTech SIM7600 4G 模块: 5 个端口按接口号区分 ----
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", \
  ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="airship_4g_at0", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", \
  ENV{ID_USB_INTERFACE_NUM}=="01", SYMLINK+="airship_4g_at1", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", \
  ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="airship_4g_at2", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", \
  ENV{ID_USB_INTERFACE_NUM}=="03", SYMLINK+="airship_4g_at3", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", \
  ENV{ID_USB_INTERFACE_NUM}=="04", SYMLINK+="airship_4g_at4", GROUP="dialout", MODE="0660"