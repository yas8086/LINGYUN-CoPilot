<?xml version="1.0"?>
<package format="2">
  <name>airship_bringup</name>
  <version>0.1.0</version>
  <description>灵云01号飞艇伴飞电脑启动配置：编排mavros、airship_bridge、airship_control、airship_safety节点</description>
  <maintainer email="dev@lingyun.local">Lingyun Airship Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>airship_bridge</exec_depend>
  <exec_depend>airship_control</exec_depend>
  <exec_depend>airship_safety</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
