VAL_TABLE_ VT_BalancingSts 1 "In balancing" 0 "Not in balancing" ;
VAL_TABLE_ VT_BmsSelfChkStatus 3 "reserved" 2 "Failed" 1 "Passed" 0 "Checking" ;
VAL_TABLE_ VT_PrechargeStatus 3 "PrechargeFailed" 2 "Precharged" 1 "Precharging" 0 "None" ;
VAL_TABLE_ VT_BcuConnectionStatus 4 "ConnectFailed" 3 "Connected" 2 "Connecting_2" 1 "Connecting_1" 0 "Disconnected" ;
