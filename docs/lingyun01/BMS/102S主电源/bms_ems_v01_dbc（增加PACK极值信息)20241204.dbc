VAL_TABLE_ TMSrunState 7 "补水泵运行状态" 6 "报警状态" 5 "外风机运行状态" 4 "水泵运行状态" 3 "制热运行状态" 2 "制冷运行状态" 1 "自检状态" 0 "机组运行状态" ;
VAL_TABLE_ TMScontrolMode 1 "进水温度控制模式" 0 "出水温度控制模式" ;
VAL_TABLE_ TMSType 6 "60KW三相" 5 "50KW三相" 4 "40KW三相" 3 "20KW三相" 2 "8KW三相" 1 "8KW单相" ;
VAL_TABLE_ Supplycode 1 "泰铂" ;
VAL_TABLE_ EMS_TMSRunlMode 4 "发4，强控TMS待机" 3 "发1，强控TMS自循环" 2 "发1，强控TMS制热" 1 "发1，强控TMS制冷" 0 "发0按照程序中默认模式和阈值运行" ;
VAL_TABLE_ EMS_TMSpowerOFF 1 "Request to power off" 0 "No request" ;
VAL_TABLE_ EMS_TMSpowerOn 1 "Description for the value '0x1'" 0 "No request" ;
VAL_TABLE_ LSS2_control 3 "无意义" 2 "强控断开" 1 "强控闭合" 0 "无请求" ;
VAL_TABLE_ EMS_SHUNT_restart 1 "重启" 0 "无请求" ;
VAL_TABLE_ EMS_ACCutOff_request 1 "BMS 切换交流侧断路器" 0 "无请求" ;
