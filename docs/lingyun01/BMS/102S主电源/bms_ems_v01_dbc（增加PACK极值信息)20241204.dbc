VAL_TABLE_ Relay_status 1 "closed" 0 "opened" ;
VAL_TABLE_ Warning_state 1 "warning" 0 "normal" ;
VAL_TABLE_ Error_state 1 "故障" 0 "正常" ;
VAL_TABLE_ IO_state 1 "normal" 0 "error" ;
VAL_TABLE_ VT_BattBalancingMode 2 "Remote balancing" 1 "Local balancing" 0 "None" ;
VAL_TABLE_ VT_RelayFaultStatus 3 "Circuit fault" 2 "Open fault" 1 "Stick fault" 0 "No fault" ;
